{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "framework": "create-react-app",
  "rewrites": [
    { "source": "/api/claude", "destination": "/api/claude" },
    { "source": "/api/ga4", "destination": "/api/ga4" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
